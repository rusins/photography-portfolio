#!/usr/bin/env bash
# Brings the Library up to date with R2: downloads files the Library is missing and lists files that
# differ from R2 without changing them. Never deletes Library files. Settings come from
# site.config.json; credentials come from your own rclone config.
# Usage: ./pull [--force] [config file]
#   --force  replace Library files that differ from R2 with the R2 version
set -euo pipefail
cd "$(dirname "$0")"
if ! command -v node >/dev/null || ! command -v rclone >/dev/null; then
  exec nix-shell --run "$(printf '%q ' ./pull "$@")"
fi
[ -d node_modules ] || npm ci
node src/cli/pull.ts "$@"
