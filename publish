#!/usr/bin/env bash
# Publishes the Library: checks and tests the code, builds the site, makes R2 mirror the Library
# and deploys the site folder to Cloudflare Pages. Settings come from site.config.json; credentials
# come from your own rclone and wrangler config.
# Usage: ./publish [config file]
set -euo pipefail
cd "$(dirname "$0")"
if ! command -v node >/dev/null || ! command -v rclone >/dev/null || ! command -v wrangler >/dev/null; then
  exec nix-shell --run "./publish $*"
fi
[ -d node_modules ] || npm ci
echo "Type checking and testing"
npm run --silent typecheck
npm test --silent
./build "$@"
node src/cli/publish.ts "$@"
